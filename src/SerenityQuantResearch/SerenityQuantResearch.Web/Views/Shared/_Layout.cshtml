@inject Serenity.Navigation.INavigationModelFactory NavigationModelFactory
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
@{
    Func<string, HtmlString> json = x => new HtmlString(Serenity.JSON.Stringify(x));
    var hideNav = (string)Context.Request.Query["hideNav"] == "1";
    var requestPath = Context.Request.Path;
    var isResearchShell = !hideNav && (requestPath == "/" || requestPath.StartsWithSegments("/Research"));
    var sidebarPaneCollapsed = !isResearchShell && Context?.Request?.Cookies?["SidebarPaneCollapsed"] == "1" ? " s-sidebar-pane-collapsed" : "";
    var bodyClass = ((ViewData["BodyClass"] as string) ?? "") + (isResearchShell ? " research-shell" : "") + sidebarPaneCollapsed;
    var currentPath = requestPath.Value ?? "/";
    bool researchActive(string href, bool root = false) => root
        ? currentPath == "/" || currentPath.StartsWith("/Research/Cpo", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Research/Parts", StringComparison.OrdinalIgnoreCase)
        : currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase);
}
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" class="@(hideNav ? " no-navigation" : "")@(isResearchShell ? " research-shell-html" : "")">
<head>
    <partial name="@MVC.Views.Shared._LayoutHead" />
    @RenderSection("Head", false)
    <title>@(ViewData["Title"]) - SerenityQuantResearch</title>
</head>
<body id="s-@(ViewData["PageId"])Page" class="@bodyClass">
<div id="PageBackground"></div>
@if (hideNav)
{
    <div id="page-outer-nonav">
        <div id="page-container" class="page-container-common">
            @RenderBody()
        </div>
    </div>
}
else if (isResearchShell)
{
    <header class="research-topbar" data-testid="research-shell-topbar">
        <a class="research-brand" href="~/" aria-label="Serenity Quant Research home">
            <span class="research-brand-mark" aria-hidden="true">SQ</span>
            <span>
                <strong>Serenity Quant Research</strong>
                <small>industrial-chain workstation</small>
            </span>
        </a>
        <nav class="research-primary-nav" aria-label="Primary research navigation" data-testid="research-primary-nav">
            <a class="@(researchActive("/Research/Cpo", root: true) ? "is-active" : "")" href="~/Research/Cpo" aria-current="@(researchActive("/Research/Cpo", root: true) ? "page" : null)">CPO Explorer</a>
            <a class="@(researchActive("/Research/Companies") ? "is-active" : "")" href="~/Research/Companies" aria-current="@(researchActive("/Research/Companies") ? "page" : null)">Company Pool</a>
            <a class="@(researchActive("/Research/Workspace") ? "is-active" : "")" href="~/Research/Workspace" aria-current="@(researchActive("/Research/Workspace") ? "page" : null)">Research Workspace</a>
        </nav>
        <div class="research-shell-status" aria-label="Research shell status">
            @if (Configuration["OpenAccess:Enabled"]?.Equals("true", StringComparison.OrdinalIgnoreCase) == true)
            {
                <span title="本地受信任 Open Access 模式" aria-label="本地受信任 Open Access 模式">Open Access</span>
            }
        </div>
    </header>
    <main class="research-shell-main" data-testid="research-shell-main">
        @if (IsSectionDefined("ContentHeader"))
        {
            <section class="research-content-header">
                @RenderSection("ContentHeader")
            </section>
        }
        <section class="research-content">
            @RenderBody()
        </section>
    </main>
}
else
{
    <partial name=@MVC.Views.Shared._Sidebar model=@(NavigationModelFactory.Create()) />
    <main class="s-main">
        <section class="content">
            @if (IsSectionDefined("ContentHeader"))
            {
                <section class="content-header">
                    @RenderSection("ContentHeader")
                </section>
            }

            @RenderBody()
        </section>
    </main>
}
</body>
</html>