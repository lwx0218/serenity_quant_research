@{
    ViewData["Title"] = "CPO Explorer";
    ViewData["PageId"] = "CpoResearch";
}

@section ContentHeader {
    <div class="cpo-page-heading">
        <div>
            <span class="cpo-eyebrow">PHYSICAL PRODUCT → COMPONENT → COMPANY</span>
            <h1>CPO Explorer</h1>
            <p>覆盖 approved CPO 9 个一级组件与 21 个真实子部件；Flat / 3D 共享 stable ID、选择状态与 evidence-safe 研究抽屉。</p>
        </div>
        <span class="cpo-coverage" id="cpo-coverage">正在读取完整 CPO taxonomy…</span>
    </div>
}

<div id="cpo-explorer-app" class="cpo-explorer-app" data-ready="false" data-selected="" data-view="three">
    <section class="cpo-explorer-workbench" aria-labelledby="cpo-explorer-title">
        <div class="cpo-explorer-topline">
            <div>
                <span class="cpo-kicker">CPO System / Full Taxonomy</span>
                <h2 id="cpo-explorer-title">完整 CPO 组件探索</h2>
                <p>悬停预览，单击锁定；Tab 聚焦组件或 callout 后用 Enter / Space 选择，Esc 或空白画布重置。</p>
            </div>
            <div class="cpo-view-switch" role="group" aria-label="Explorer view switch">
                <button id="cpo-view-flat" type="button" data-view-target="flat" aria-pressed="false">Flat View</button>
                <button id="cpo-view-three" type="button" data-view-target="three" aria-pressed="true" class="is-active">3D Exploded</button>
            </div>
        </div>

        <div id="cpo-state-line" class="cpo-state-line" aria-live="polite">
            <strong>Overview</strong>
            <span>选择任一 CPO 组件查看现有研究目录中的真实 child parts；材料缺口保持显式，不把示例数据呈现为事实。</span>
        </div>

        <div id="cpo-canvas-frame" class="cpo-canvas-frame" role="application" aria-label="CPO Explorer canvas">
            <div class="cpo-viewport-stage">
