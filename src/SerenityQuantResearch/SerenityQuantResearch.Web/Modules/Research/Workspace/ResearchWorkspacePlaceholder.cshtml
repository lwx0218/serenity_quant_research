@{
    ViewData["Title"] = "Research Workspace";
    ViewData["PageId"] = "ResearchWorkspace";
}

@section ContentHeader {
    <div class="research-page-heading research-workspace-placeholder-heading">
        <span class="research-eyebrow">READ-ONLY WORKSPACE · R6 DELIVERY SURFACE</span>
        <h1>Research Workspace</h1>
        <p>当前 R2 仅交付 research shell 与 primary navigation。Workspace v1 将在 R6 以 read-only、linked-object-first 方式交付。</p>
    </div>
}

<section class="research-placeholder" aria-labelledby="workspace-placeholder-title">
    <div>
        <span class="research-eyebrow">PLACEHOLDER</span>
        <h2 id="workspace-placeholder-title">Knowledge-centric workspace route reserved</h2>
        <p>此页面不提供写入、Graph、New Note、ResearchNote、OpenQuestion 或 Backlink persistence；它只证明 approved primary navigation 的目标路由存在。</p>
    </div>
    <a class="research-placeholder-link" href="~/Research/Cpo">返回 CPO Explorer</a>
</section>
