@{
    ViewData["Title"] = "CPO 公司研究池";
    ViewData["PageId"] = "CompanyUniverse";
}

@section ContentHeader {
    <div class="company-page-heading">
        <div>
            <span class="company-eyebrow">PHASE 1 · COMPANY UNIVERSE</span>
            <h1>CPO 公司研究池与比较</h1>
            <p>只呈现稳定 ID 和显式 CompanyExposure / Evidence 关系；不按股价或市场表现排名。</p>
        </div>
        <span id="company-result-count" class="company-count" aria-live="polite">正在读取 20 家 seed 公司…</span>
    </div>
}

<main id="company-research-app" class="company-research-app" data-mode="universe">
    <form id="company-filters" class="company-filter-panel" aria-label="公司研究池筛选">
        <label class="company-filter-wide">搜索
            <input name="SearchText" class="form-control form-control-sm" type="search" placeholder="公司、ticker 或稳定 ID" autocomplete="off" />
        </label>
        <label>物理部件<select name="PartId" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>产业链节点<select name="ChainNodeId" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>公司角色<select name="Role" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>交易所 / 市场<select name="Exchange" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>地区<select name="CountryRegion" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>公司池层级<select name="UniverseLayer" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>覆盖优先级<select name="CoveragePriority" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>核验状态<select name="VerificationState" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>证据覆盖<select name="EvidenceCoverage" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>新鲜度<select name="Freshness" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <div class="company-filter-actions">
            <button id="company-clear-filters" class="btn btn-outline-secondary btn-sm" type="button">清除筛选</button>
            <a class="btn btn-link btn-sm" href="?view=table">表格 fallback 模式</a>
        </div>
    </form>

    <section class="company-grid-panel" aria-labelledby="company-grid-title">
        <div class="company-panel-heading">
            <div><span class="company-eyebrow">SLEEKGRID FIRST</span><h2 id="company-grid-title">高密度公司池</h2></div>
            <span id="company-grid-status" role="status" aria-live="polite">加载中…</span>
        </div>
        <div id="company-grid" class="company-sleek-grid" aria-label="公司研究池 SleekGrid；方向键移动，Tab 进入单元格控件"></div>
        <div id="company-grid-error" class="alert alert-warning" role="alert" hidden>SleekGrid 无法初始化；请使用下方原生表格。</div>
    </section>

    <section id="company-comparison" class="company-comparison" aria-labelledby="company-comparison-title">
        <div class="company-panel-heading">
            <div><span class="company-eyebrow">BOUNDED COMPARISON · MAX 5</span><h2 id="company-comparison-title">多公司比较</h2></div>
            <button id="company-clear-comparison" class="btn btn-outline-secondary btn-sm" type="button" disabled>清除比较</button>
        </div>
        <p id="company-comparison-status" class="company-gap" aria-live="polite">尚未选择公司。可在 SleekGrid 或 fallback 表格中用复选框选择。</p>
        <div id="company-comparison-content"></div>
    </section>

    <details id="company-table-fallback" class="company-fallback" open>
        <summary><strong>非网格 / 原生表格 fallback</strong><span>键盘与非指针访问始终可用</span></summary>
        <div class="table-responsive">
            <table class="table table-sm company-table">
                <thead><tr><th scope="col">比较</th><th scope="col">公司</th><th scope="col">Ticker</th><th scope="col">市场</th><th scope="col">地区</th><th scope="col">角色</th><th scope="col">核验状态</th><th scope="col">证据覆盖</th><th scope="col">新鲜度</th></tr></thead>
                <tbody id="company-table-body"></tbody>
            </table>
        </div>
    </details>
</main>

<noscript><div class="alert alert-warning">请启用 JavaScript 以从 CompanyUniverseService 读取公司池。</div></noscript>
@Html.ModulePageInit("~/esm/Modules/Research/Company/CompanyUniversePage.js", new { mode = "universe" })
