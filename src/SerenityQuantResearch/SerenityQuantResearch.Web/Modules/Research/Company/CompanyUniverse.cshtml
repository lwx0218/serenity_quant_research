@{
    ViewData["Title"] = "CPO 公司研究池";
    ViewData["PageId"] = "CompanyUniverse";
}

@section ContentHeader {
    <div class="company-page-heading">
        <div>
            <span class="company-eyebrow">R5 · COMPANY POOL</span>
            <h1>CPO 公司研究池</h1>
            <p>Card View 默认浏览；List View 共享同一公司集合、轻量筛选和 Explorer 来源 context。</p>
        </div>
        <span id="company-result-count" class="company-count" aria-live="polite">正在读取 seed 公司…</span>
    </div>
}

<main id="company-research-app" class="company-research-app" data-mode="universe" data-view="card">
    <section class="company-context-ribbon" aria-label="Explorer source context">
        <span class="company-eyebrow">SOURCE CONTEXT</span>
        <strong data-company-source-context>Company Pool</strong>
        <p>来源路径可驱动初始筛选、排序解释、Quick Drawer 与 Full Detail；不会把 prototype/mock 内容升级为研究事实。</p>
    </section>

    <form id="company-filters" class="company-filter-panel" aria-label="公司研究池轻量筛选">
        <label class="company-filter-wide">搜索
            <input name="SearchText" class="form-control form-control-sm" type="search" placeholder="公司、ticker 或稳定 ID" autocomplete="off" />
        </label>
        <label>部件 / 材料组<select name="PartId" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>产业链节点<select name="ChainNodeId" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>公司角色<select name="Role" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>市场 / 地区<select name="CountryRegion" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <label>暴露状态<select name="VerificationState" class="form-select form-select-sm"><option value="">全部</option></select></label>
        <div class="company-filter-actions">
            <button id="company-clear-filters" class="btn btn-outline-secondary btn-sm" type="button">清除筛选</button>
        </div>
    </form>

    <section class="company-pool-panel" aria-labelledby="company-pool-title">
        <div class="company-panel-heading">
            <div>
                <span class="company-eyebrow">CARD-FIRST RESEARCH BROWSE</span>
                <h2 id="company-pool-title">Company Pool</h2>
                <p data-company-source-context>Company Pool</p>
            </div>
            <div class="company-view-switch" role="group" aria-label="Company Pool view">
                <button class="btn btn-primary btn-sm is-active" type="button" data-company-view="card" aria-pressed="true">Card View</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-company-view="list" aria-pressed="false">List View</button>
            </div>
        </div>
        <p id="company-pool-status" class="company-pool-status" role="status" aria-live="polite">加载中…</p>
        <div id="company-card-panel" class="company-card-panel">
            <div id="company-card-list" class="company-card-list" aria-label="公司卡片列表"></div>
        </div>
        <div id="company-list-panel" class="company-list-panel" hidden>
            <div class="company-list-header" aria-hidden="true"><span>公司</span><span>市场</span><span>角色</span><span>状态</span><span>证据</span><span>出现原因</span></div>
            <div id="company-list-body" class="company-list-body" aria-label="公司紧凑列表"></div>
        </div>
    </section>

    <aside id="company-quick-drawer" class="company-quick-drawer" role="dialog" aria-modal="false" aria-labelledby="company-quick-drawer-title" aria-hidden="true" hidden>
        <div class="company-drawer-toolbar">
            <span class="company-eyebrow">QUICK COMPANY DRAWER</span>
            <button id="company-quick-drawer-close" class="btn btn-outline-secondary btn-sm" type="button" aria-label="关闭 Quick Company Drawer">×</button>
        </div>
        <h2 id="company-quick-drawer-title" class="visually-hidden">Quick Company Drawer</h2>
        <div id="company-quick-drawer-content"></div>
    </aside>
</main>

<noscript><div class="alert alert-warning">请启用 JavaScript 以从 CompanyUniverseService 读取公司池。</div></noscript>
@Html.ModulePageInit("~/esm/Modules/Research/Company/CompanyUniversePage.js", new { mode = "universe" })
