@{
    ViewData["Title"] = "产业链节点详情";
    ViewData["PageId"] = "ChainNodeResearchDetail";
    var chainNodeId = ViewData["ChainNodeId"] as string;
}

@section ContentHeader {
    <div class="company-page-heading">
        <div>
            <a class="company-back-link" href="~/Research/Companies">← 返回公司研究池</a>
            <span class="company-eyebrow">INDUSTRY-CHAIN CROSS NAVIGATION</span>
            <h1>产业链节点详情</h1>
        </div>
    </div>
}

<main id="company-research-app" class="company-research-app company-detail-app" data-mode="chain" data-chain-node-id="@chainNodeId">
    <article id="company-detail-content" aria-live="polite" aria-busy="true">
        <div class="company-loading">正在读取 <code>@chainNodeId</code>…</div>
    </article>
</main>

@Html.ModulePageInit("~/esm/Modules/Research/Company/CompanyUniversePage.js", new { mode = "chain", chainNodeId })
