{
  "name": "serenityquantresearch.web",
  "dependencies": {
    "@serenity-is/assets": "./node_modules/.dotnet/serenity.assets",
    "@serenity-is/corelib": "./node_modules/.dotnet/serenity.corelib",
    "@serenity-is/demo.northwind": "./node_modules/.dotnet/serenity.demo.northwind",
    "@serenity-is/domwise": "./node_modules/.dotnet/serenity.domwise",
    "@serenity-is/extensions": "./node_modules/.dotnet/serenity.extensions",
    "@serenity-is/sleekgrid": "./node_modules/.dotnet/serenity.sleekgrid",
    "bootstrap-datepicker": "1.10.1",
    "chart.js": "4.5.1",
    "daterangepicker": "3.1.0",
    "dompurify": "3.4.13",
    "flatpickr": "4.6.13",
    "jquery-knob": "1.2.11",
    "jquery-sparkline": "2.4.0",
    "jvectormap-content": "0.2.0",
    "jvectormap-next": "3.2.0",
    "moment": "2.30.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@serenity-is/tsbuild": "10.3.7"
  },
  "scripts": {
    "build": "node ./tsbuild.js",
    "build:watch": "node ./tsbuild.js --watch",
    "test:ui": "npm run test:ui:unit && npm run test:ui:browser",
    "test:ui:unit": "node --test tests-ui/*.test.mjs",
    "test:ui:browser": "bash tests-ui/run-browser-smoke.sh && bash tests-ui/run-r5-company-browser-smoke.sh && bash tests-ui/run-r6-workspace-browser-smoke.sh && bash tests-ui/run-r7-integrated-journey-browser-smoke.sh",
    "test:ui:browser:r4": "bash tests-ui/run-browser-smoke.sh",
    "test:ui:browser:r5": "bash tests-ui/run-r5-company-browser-smoke.sh",
    "test:ui:browser:r6": "bash tests-ui/run-r6-workspace-browser-smoke.sh",
    "test:ui:browser:r7": "bash tests-ui/run-r7-integrated-journey-browser-smoke.sh",
    "pnpm:devPreinstall": "dotnet build -target:RestoreNodeTypes",
    "preinstall": "dotnet build -target:RestoreNodeTypes",
    "tsc": "tsc"
  },
  "private": true,
  "type": "module"
}